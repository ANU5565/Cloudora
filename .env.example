# ==========================================
# CLOUDORA ENVIRONMENT CONFIGURATION
# ==========================================

# -----------------
# FRONTEND SETTINGS
# -----------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# -----------------
# BACKEND SETTINGS
# -----------------
APP_ENV=development
APP_NAME=Cloudora
APP_URL=http://localhost:8000
FRONTEND_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL in production; SQLite supported for zero-config local dev & tests)
DATABASE_URL=sqlite:///./cloudora.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/cloudora

# Security & Authentication
JWT_SECRET_KEY=replace-with-a-cryptographically-secure-random-256-bit-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Object Storage Configuration
# Set STORAGE_PROVIDER to "local" for dev/testing, or "s3" for Cloudflare R2 / AWS S3
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage_data

# Cloudflare R2 / AWS S3 (Required only when STORAGE_PROVIDER=s3)
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET_NAME=cloudora-private-files
S3_REGION=auto
S3_ACCESS_KEY_ID=your-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Quota & Limits
DEFAULT_STORAGE_QUOTA=5368709120   # 5 GB in bytes
MAX_UPLOAD_SIZE=262144000          # 250 MB in bytes
SIGNED_URL_TTL_SECONDS=900         # 15 minutes
TRASH_RETENTION_DAYS=30
